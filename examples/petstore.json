{
  "openapi": "3.0.3",
  "info": {
    "title": "Pet Store",
    "version": "1.4.0",
    "description": "Small example API used to demo MOG."
  },
  "servers": [
    { "url": "https://api.example.com/v1" }
  ],
  "tags": [
    { "name": "pets", "description": "Everything about pets" },
    { "name": "owners", "description": "People who own pets" }
  ],
  "paths": {
    "/pets": {
      "get": {
        "tags": ["pets"],
        "operationId": "listPets",
        "summary": "List pets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of pets",
            "headers": {
              "X-Total-Count": { "schema": { "type": "integer" } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["pets"],
        "operationId": "createPet",
        "summary": "Create a pet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewPet" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "tags": ["pets"],
        "operationId": "getPet",
        "summary": "Fetch one pet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "One pet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["pets"],
        "operationId": "deletePet",
        "summary": "Delete one pet",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" }
        }
      }
    },
    "/owners": {
      "get": {
        "tags": ["owners"],
        "operationId": "listOwners",
        "summary": "List owners",
        "responses": {
          "200": {
            "description": "Owners",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Owner" }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "example": { "status": "ok", "uptime": 42 }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "required": ["id", "name", "species", "status"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "maxLength": 40 },
          "species": { "type": "string", "enum": ["dog", "cat", "bird", "lizard"] },
          "status": { "type": "string", "enum": ["available", "pending", "sold"] },
          "bornAt": { "type": "string", "format": "date" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 4
          },
          "photoUrl": { "type": "string", "format": "uri" },
          "weightKg": { "type": "number", "minimum": 0.2, "maximum": 90 },
          "owner": { "$ref": "#/components/schemas/Owner" }
        }
      },
      "NewPet": {
        "type": "object",
        "required": ["name", "species"],
        "properties": {
          "name": { "type": "string" },
          "species": { "type": "string", "enum": ["dog", "cat", "bird", "lizard"] }
        }
      },
      "Owner": {
        "type": "object",
        "required": ["id", "email"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "fullName": { "type": "string" },
          "phone": { "type": "string" },
          "city": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "traceId": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
